# --- Modo più semplice: ponte Apps Script (consigliato) ---
# Incolla docs/apps-script/Code.gs nel foglio del bilancio (Estensioni → Apps Script)
# e pubblicalo come "App web". Con queste due variabili NON servono service
# account, chiavi JSON né OAuth: lo script usa il tuo account Google.
APPS_SCRIPT_URL=
# Uguale alla proprietà script APP_SECRET
APPS_SCRIPT_SECRET=

# --- Google Sheets (solo lato server: MAI con prefisso VITE_) ---
# ID del foglio: la parte tra /d/ e /edit nell'URL di Google Sheets
# (con il ponte Apps Script è facoltativo: si usa il foglio collegato allo script)
GOOGLE_SHEET_ID=
# Service account con accesso in lettura al foglio (condividi il foglio con questa email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chiave privata del service account; i "\n" letterali vengono convertiti in a capo
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"

# Valuta base per aggregati e patrimonio (ISO 4217)
BASE_CURRENCY=EUR

# Opzionale ma consigliato: token richiesto dall'API. L'utente lo inserisce
# una volta nell'app; non viene incluso nel bundle frontend.
APP_ACCESS_TOKEN=

# Opzionale: Google Sheet separato in cui salvare gli strumenti di investimento
# (tipo ETF/azione/obbligazione, ticker, ISIN, cedola, scadenza…). Condividilo
# con il service account come Editor. Richiede anche APP_ACCESS_TOKEN.
INVESTMENTS_SHEET_ID=

# --- Cedolini su Google Drive (scrittura) ---
# Cartella Drive che contiene le cartelle per anno. L'app crea/usa:
#   <cartella>/2026/busta_paga_2026   (Google Sheet, una riga per cedolino)
#   <cartella>/2026/busta_paga/       (PDF originali)
# L'ID è la parte finale dell'URL: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# OAuth con il tuo account Google (necessario per account @gmail.com: i service
# account non hanno spazio Drive e non possono caricare file nel tuo Drive).
# Client di tipo "App desktop"; il refresh token si ottiene con `npm run google:auth`.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
